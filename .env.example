# Base de données (PostgreSQL pour Supabase/Neon ou local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zentube?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-super-secret-key-in-production-min-32-chars"

# Google OAuth & YouTube Data API
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
YOUTUBE_API_SERVER_KEY="your-optional-youtube-server-api-key"

# Redis Cache (Optionnel pour le développement local, un fallback mémoire est inclus)
REDIS_URL="redis://localhost:6379"
